{
  "item": [
    {
      "id": "ab832a26-29ae-4461-a06a-0a212e7d1c56",
      "name": "Authentication",
      "description": {
        "content": "",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "fb69e04f-5d9e-497f-96a7-0e5493c8ad42",
          "name": "Issue a Passkey access token",
          "request": {
            "name": "Issue a Passkey access token",
            "description": {
              "content": "Exchange client credentials (API key/secret issued from the Cvent\nPasskey portal) for an access token that authorises subsequent\nRegLink requests.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "authentication",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "grant_type",
                  "value": "<string>",
                  "description": "(Required) "
                }
              ]
            }
          },
          "response": [
            {
              "id": "9c2e5a18-4839-4b15-a4c5-fc5f77debc22",
              "name": "Token issued",
              "originalRequest": {
                "url": {
                  "path": [
                    "authentication",
                    "token"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: basic",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Basic <credentials>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "urlencoded",
                  "urlencoded": [
                    {
                      "disabled": false,
                      "description": {
                        "content": "(Required) ",
                        "type": "text/plain"
                      },
                      "key": "grant_type",
                      "value": "<string>"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"access_token\": \"string\",\n  \"token_type\": \"Bearer\",\n  \"expires_in\": 3681\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
        }
      ],
      "event": []
    }
  ],
  "event": [],
  "variable": [
    {
      "type": "string",
      "value": "https://api-platform.cvent.com/reglink/v1",
      "key": "baseUrl"
    }
  ],
  "auth": {
    "type": "oauth2",
    "oauth2": [
      {
        "key": "scope",
        "value": "passkey:read passkey:write"
      },
      {
        "key": "accessTokenUrl",
        "value": "https://api-platform.cvent.com/reglink/v1/authentication/token"
      },
      {
        "key": "grant_type",
        "value": "client_credentials"
      }
    ]
  },
  "info": {
    "_postman_id": "e663463d-cb05-4bfe-ba01-3ffc1168cbe8",
    "name": "Cvent Passkey RegLink REST Authentication API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Cvent Hospitality Cloud / Passkey RegLink REST API. Connects external\nsystems to Passkey events and hotel reservation data so that\nregistration platforms can pass attendee information to Passkey,\nlook up event and hotel availability, and create, modify, or cancel\nindividual reservation requests.\n\nBest-effort spec derived from the Cvent developer portal\n(https://developers.cvent.com/docs/passkey/REST/overview and\n/docs/passkey/REST/getting-started). Refer to the developer portal\nfor the authoritative reference.\n\n\nContact Support:\n Name: Cvent Developer Portal",
      "type": "text/plain"
    }
  }
}